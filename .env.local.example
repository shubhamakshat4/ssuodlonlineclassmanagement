NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
MS_TENANT_ID=your_microsoft_tenant_id
MS_CLIENT_ID=your_microsoft_client_id
MS_CLIENT_SECRET=your_microsoft_client_secret
MS_SERVICE_ACCOUNT_USER_ID=your_service_account_object_id
MS_SERVICE_ACCOUNT_UPN=classes@yourtenant.onmicrosoft.com
ALLOWED_STUDENT_DOMAIN=srisriuniversity.edu.in
APP_TIMEZONE=Asia/Kolkata
JOIN_WINDOW_LEAD_MINUTES=10
RECORDING_RETENTION_DAYS=30
SESSION_GENERATION_HORIZON_DAYS=21

# Google OAuth (configured in Supabase Auth > Providers; only needed here for local `supabase start`)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_oauth_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_oauth_client_secret

# Graph mode for the Next.js app + tests: "mock" (default in CI) or "real" (Edge Functions only)
GRAPH_MODE=mock

# Phase 6 spike only (scripts/graph-spike.ts). Use a TEST teacher account, never real faculty.
SPIKE_TEACHER_UPN=test.teacher@yourtenant.onmicrosoft.com

# Public origin of the Next.js app (used for invite / callback links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Recording mode for the provisioner: auto (request recordAutomatically) | manual (tenant rejects it; harvest from OneDrive)
GRAPH_RECORDING_MODE=auto

# Optional: incoming-webhook URL for error notifications (Slack/Teams/Better Stack)
ERROR_WEBHOOK_URL=

# Direct Postgres connection for migrations/ops (never NEXT_PUBLIC_)
SUPABASE_DB_URL=postgresql://postgres:your_db_password@db.your-project.supabase.co:5432/postgres

# Supabase CLI personal access token (deploy functions / secrets) and the cron shared secret
SUPABASE_ACCESS_TOKEN=sbp_your_access_token
CRON_SECRET=random_64_hex_chars_also_stored_in_vault_as_cron_secret
